{
  "name": "@fabricmc/cli",
  "type": "module",
  "scripts": {
    "build": "npm run fontgen && npm run check && node bundle.ts",
    "prestart": "npm run build",
    "start": "node bundled.mjs",
    "check": "tsc --noEmit",
    "test": "npm run fontgen && npm run check && node bundle.ts test && node --test test-bundled.mjs",
    "fontgen": "node fontgen.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "version": "0.0.0",
  "description": "Command-line tools for Fabric mod development",
  "license": "MIT",
  "bin": {
    "fabric": "./bundled.mjs"
  },
  "files": [
    "bundled.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricMC/fabricmc.net.git",
    "directory": "cli"
  },
  "devDependencies": {
    "@cliffy/ansi": "npm:@jsr/cliffy__ansi@1.2.1",
    "@cliffy/command": "npm:@jsr/cliffy__command@1.2.1",
    "@cliffy/prompt": "npm:@jsr/cliffy__prompt@1.2.1",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "@types/wawoff2": "^1.0.2",
    "esbuild": "0.20.0",
    "fast-xml-parser": "5.11.1",
    "opentype.js": "0.4.11",
    "pngjs": "7.0.0",
    "pureimage": "0.4.13",
    "typescript": "^5.1.3",
    "wawoff2": "2.0.1",
    "@fabricmc/scripts": "0.0.0"
  }
}
